rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(homeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(homeId + "_" + request.auth.uid));
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /homes/{homeId} {
      allow read: if isMember(homeId);
      allow write: if false;
    }

    match /alarmStates/{homeId} {
      allow read: if isMember(homeId);
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if isMember(resource.data.homeId);
      allow write: if false;
    }

    match /contacts/{contactId} {
      allow read: if isMember(resource.data.homeId);
      allow write: if false;
    }

    match /commands/{commandId} {
      allow read: if isMember(resource.data.homeId);
      allow write: if false;
    }

    match /pushTokens/{tokenId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
