# Shared identifiers
DEVICE_ID=alarm-demo-001
HOME_ID=home-demo-001

# HiveMQ Cloud (use mqtts://host:8883)
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gateway
PORT=3000
ALLOWED_ORIGINS=*
PIN_PEPPER=replace-with-a-long-random-secret
DEMO_MODE=true

# Alert providers
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
RESEND_FROM=Alarme Residencial <alarme@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Mobile public configuration (copy to apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_DEMO_MODE=true
