# Shared identifiers
DEVICE_ID=alarm-demo-001
HOME_ID=home-demo-001

# HiveMQ Cloud (use mqtts://host:8883)
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gateway
PORT=3000
ALLOWED_ORIGINS=*
PIN_PEPPER=replace-with-a-long-random-secret
DEMO_MODE=true

# Alert providers
EXPO_ACCESS_TOKEN=
# Resend: pegue em https://resend.com/api-keys (botão "Create API Key").
RESEND_API_KEY=
# Em teste use o remetente onboarding@resend.dev (só entrega para o e-mail da
# sua conta Resend). Para outros destinos, verifique um domínio em Resend > Domains.
RESEND_FROM=Alarme Residencial <onboarding@resend.dev>
# Twilio: Account SID e Auth Token ficam no topo do painel em https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio com SMS habilitado (Phone Numbers > Manage > Active numbers).
TWILIO_FROM=
# WhatsApp via Twilio (sandbox: whatsapp:+14155238886) — deixar vazio por enquanto.
TWILIO_WHATSAPP_FROM=

# TESTE: destinatários travados. Enquanto preenchidos, TODO e-mail/SMS vai para
# estes endereços, ignorando os contatos. Limpar para voltar ao envio normal.
ALERT_OVERRIDE_EMAIL=mabrugval@gmail.com
ALERT_OVERRIDE_SMS=+5511947007235

# Mobile public configuration (copy to apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_DEMO_MODE=true
